{
  "name": "rea-webapp",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive web app that reverse engineers any public web app or site from a URL: tech stack, design system, structure, scripts, third parties, security posture and a rebuild blueprint.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "analyze": "node server/cli.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^6.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
